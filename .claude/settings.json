{
  "enabledMcpjsonServers": ["context7"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/kingsonwu/programming/OctopusGarage/tmux-claude-bot/scripts/agent-command-guard.sh\"",
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -z \"$f\" ] && exit 0; npx @biomejs/biome check \"$f\" --no-errors-on-unmatched 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
