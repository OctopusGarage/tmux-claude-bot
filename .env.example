# Telegram bot token from @BotFather. Optional — leave blank for a Feishu/Lark-only
# install (configure Feishu via `npm run setup:lark`). At least one adapter must be set.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# The command typed into tmux to launch Claude. A full command line — may carry
# leading `VAR=value` env assignments (e.g. a config dir, model, or API key).
CLAUDE_START_COMMAND=claude-yolo
# Optional: configure MORE start commands to choose from. When more than one is
# set, the Start button shows a picker and you pick which to launch. Number them
# contiguously (_2, _3, …); each may have an optional friendly CLAUDE_START_LABEL_n
# (otherwise a short label is derived from the command). Example:
#   CLAUDE_START_COMMAND_2=CLAUDE_CONFIG_DIR=~/.claude-work ANTHROPIC_MODEL=claude-opus-4-8 claude-yolo
#   CLAUDE_START_LABEL_2=Work
# Optional: Codex flavors (mirror CLAUDE_START_COMMAND_*). Absent => codex disabled.
# They appear in the same Start picker, tagged as codex. Number contiguously.
#   CODEX_START_COMMAND=codex-stella
#   CODEX_START_LABEL=Stella
#   CODEX_START_COMMAND_2=codex-farmer
#   CODEX_START_LABEL_2=Farmer
IDLE_POLL_TICKS=3
POLL_INTERVAL_MS=1000
MAX_OUTPUT_LINES=200
MAX_MESSAGE_LENGTH=3500
# Max length of a prompt accepted from the user (decoupled from the reply
# truncation limit above). Telegram never delivers a single message over 4096.
MAX_INBOUND_LENGTH=4096
RATE_LIMIT_MS=2000
SESSION_WARMUP_MS=500
MAX_QUEUE_SIZE=10
MAX_WAIT_READY_MS=60000
MAX_WAIT_DONE_MS=300000
# Absolute cap on one prompt's wait. After each MAX_WAIT_DONE_MS round the bot
# sends a one-time "still running" notice and keeps waiting until this total,
# then gives up with the partial output. Default 1 hour.
MAX_WAIT_DONE_TOTAL_MS=3600000
# Max tmux sessions processed concurrently; further sessions wait their turn.
MAX_CONCURRENT_SESSIONS=5
# Comma-separated Telegram user IDs allowed to use the bot (empty = reject everyone).
TELEGRAM_ALLOWED_USER_IDS=
CD_ALLOWED_DIRS=
PROJECT_SESSION_PREFIX=tmux_proj_
# Bot UI language: en / zh / zh-TW / yue / ja / es. Shared default, set by the
# setup wizard's language picker. Each channel can override via /lang
# (TELEGRAM_UI_LANG / LARK_UI_LANG). Default zh.
UI_LANG=zh
# Optional HTTP(S) proxy for reaching the Telegram Bot API.
TELEGRAM_HTTP_PROXY=
# Long-poll timeout (seconds) for getUpdates; grammy's default is 30. Behind a
# flaky proxy that drops idle upstream connections after a few seconds, lower
# this below that cut-off (e.g. 3) so each poll returns cleanly instead of being
# cut mid-hold and 409-ing the next call. 0 = short polling. Blank = default 30.
TELEGRAM_LONGPOLL_TIMEOUT_SEC=
# How often (ms) to reconcile the reboot-recovery "running sessions" roster
# against live tmux, so sessions started/exited directly in tmux (outside the bot)
# are tracked for /recover too. Blank = default 300000 (5 min); 0 disables.
RUNNING_SWEEP_MS=
# How often (ms) to close long-idle project agents. Only exits the agent process;
# tmux/project state stays, so the next use can resume quickly. Blank = 3600000
# (1 hour); 0 disables.
SESSION_IDLE_REAPER_TICK_MS=
# Close project agents after this much idle time. Blank = 259200000 (3 days);
# 0 disables.
SESSION_IDLE_REAPER_MAX_IDLE_MS=
# Run reboot recovery automatically on boot (recreate + relaunch the agents that
# were running before a machine reboot, resuming their conversations). Idempotent:
# a no-op when tmux survived a plain bot restart. Blank = enabled; false/0 = off.
AUTO_RECOVER=
# Voice transcription (optional). Install project-managed via: npm run whisper:install
# then point this at the printed path (e.g. <repo>/.venv/bin/mlx_whisper). Blank = disabled.
MLX_WHISPER_BIN=
# Forced voice recognition language: zh / en / yue / ja / es / any 2-letter code,
# or "auto" to let whisper detect (it often misreads Chinese as Japanese). Default zh.
# Shared default recognition language. Each channel can override it independently
# via /voice_lang (written to TELEGRAM_WHISPER_LANGUAGE / LARK_WHISPER_LANGUAGE),
# so e.g. Feishu can be Cantonese (yue) while Telegram stays Mandarin (zh).
WHISPER_LANGUAGE=zh
# Whisper model. Default mlx-community/whisper-large-v3-turbo — the only model
# family whose tokenizer supports every offered language (incl. Cantonese "yue";
# smaller models crash on it). Weights (~1.5GB) download from HuggingFace on first
# use. Set a smaller model (e.g. mlx-community/whisper-tiny) only if you don't use yue.
WHISPER_MODEL=
# Optional local prompt translation. Default off. Run `npm run translate:install`,
# then set PROMPT_TRANSLATE_MODE=argos to translate prompts before sending them
# to the tmux agent. This applies to chat text, voice transcriptions, TUI, and CLI send.
PROMPT_TRANSLATE_MODE=off
# Shared language pair and timeout. Argos language codes are short codes like zh/en/ja/es.
PROMPT_TRANSLATE_FROM=zh
PROMPT_TRANSLATE_TO=en
PROMPT_TRANSLATE_TIMEOUT_MS=15000
# Optional per-channel override: off / argos / argos_zh_en. Blank inherits shared values.
TELEGRAM_PROMPT_TRANSLATE_MODE=
TELEGRAM_PROMPT_TRANSLATE_FROM=
TELEGRAM_PROMPT_TRANSLATE_TO=
LARK_PROMPT_TRANSLATE_MODE=
LARK_PROMPT_TRANSLATE_FROM=
LARK_PROMPT_TRANSLATE_TO=
CONTROL_PROMPT_TRANSLATE_MODE=
CONTROL_PROMPT_TRANSLATE_FROM=
CONTROL_PROMPT_TRANSLATE_TO=
# Python executable with argostranslate installed. Blank defaults to <repo>/.venv/bin/python.
ARGOS_TRANSLATE_PYTHON=

# Keep the Mac awake while the bot runs on AC power (macOS only). When 1, the bot
# starts `caffeinate -s` bound to its lifetime, so it can stay reachable while
# plugged in; on battery power, the Mac may sleep normally. Does NOT cover
# lid-closed (clamshell) sleep — for that also run `sudo pmset -a disablesleep 1`.
# The setup wizard prompts for this on macOS (setup --reconfigure to change).
TCB_KEEP_AWAKE=0

# Lark adapter (optional). Leave LARK_ENABLED=false to disable.
# Easiest path: run `npm run setup:lark` — scan a QR code to create the app and
# this block (incl. your own open_id) is filled in for you automatically.
# Manual alternative: create a self-built app on the Feishu Open Platform, enable
# the bot capability, and receive events via "long connection (WebSocket)".
LARK_ENABLED=false
LARK_APP_ID=
LARK_APP_SECRET=
# Comma-separated open_id allowlist (empty = reject everyone).
LARK_ALLOWED_OPEN_IDS=
# feishu (open.feishu.cn) | lark (open.larksuite.com)
LARK_DOMAIN=feishu

# Batch scheduler tick interval ms (0 = disabled); account quota pause threshold (%); reprobe delay ms.
BATCH_SCHEDULER_TICK_MS=8000
BATCH_SCHEDULER_QUOTA_PCT=99
BATCH_SCHEDULER_REPROBE_MS=1800000

# Runtime guardian (optional). Watches bot-owned automation artifacts while the
# bot is running. fast-heal delegates narrow tmux-claude-bot self-repair through
# the existing Loop Supervisor; observe only records findings. It must not edit
# target project repositories.
RUNTIME_GUARDIAN_ENABLED=false
RUNTIME_GUARDIAN_MODE=fast-heal
RUNTIME_GUARDIAN_WORKTREE_ISOLATION=auto # isolated | source | auto; fast-heal auto uses source when safe
RUNTIME_GUARDIAN_TICK_MS=120000
RUNTIME_GUARDIAN_LOOKBACK_MS=86400000
RUNTIME_GUARDIAN_COOLDOWN_MS=1800000
RUNTIME_GUARDIAN_REPO_PATH=
RUNTIME_GUARDIAN_REPAIR_BRANCH=dev
RUNTIME_GUARDIAN_MAX_FINDINGS_PER_TICK=3

# Daily scheduled task audit (optional). Checks the previous Singapore day and
# sends a success/failure/missing summary. Cron is UTC; 0 2 * * * = 10:00 SGT.
TASK_AUDIT_ENABLED=false
TASK_AUDIT_SCHEDULE=0 2 * * *
TASK_AUDIT_TICK_MS=300000
TASK_AUDIT_CHANNEL=both
TASK_AUDIT_AUTO_REPAIR=false
TASK_AUDIT_REPO_PATH=
TASK_AUDIT_REPAIR_BRANCH=dev
TASK_AUDIT_REPAIR_WORKTREE_ISOLATION=isolated # isolated | source | auto

# Loop Engineering (optional). Blank config file or tick 0 disables the managed loop.
LOOP_ENGINEERING_CONFIG_FILE=
LOOP_ENGINEERING_TICK_MS=300000
# Loop Supervisor (optional). Required only for Loop projects with
# runner.kind=agent-supervised; starts a reserved tmux_proj_loop-supervisor agent
# that receives scheduled work orders through the bot queue.
LOOP_SUPERVISOR_ENABLED=false
LOOP_SUPERVISOR_AGENT=codex
LOOP_SUPERVISOR_DIR=        # blank -> <state-dir>/loop-supervisor
LOOP_SUPERVISOR_POOL_SIZE=1 # 1 keeps tmux_proj_loop-supervisor; >1 uses -1/-2/... slots
LOOP_SUPERVISOR_RESET_BEFORE_WORK_ORDER=clear # none | compact | clear
LOOP_SUPERVISOR_WORKTREE_ISOLATION=isolated # isolated | source | auto

# Home operator session (optional). When enabled, the bot auto-starts an agent in a
# dedicated session that becomes the default chat target when no project is selected,
# so you manage the fleet by talking to it. The agent MUST start with
# --dangerously-skip-permissions (chat can't answer prompts). Reserved from autopilot.
HOME_OPERATOR_ENABLED=false
HOME_OPERATOR_DIR=        # blank → <state-dir>/home
HOME_OPERATOR_AGENT=claude   # claude | codex (codex requires CODEX_START_COMMAND to be set, else the operator falls back to claude)

# Prompt library (optional; browse saved prompts via /prompts). Disabled unless
# PROMPT_MCP_COMMAND is set — it launches the forge-mcp-server MCP server (stdio).
PROMPT_MCP_COMMAND=        # blank → /prompts disabled. e.g. uv  (or an absolute python path)
PROMPT_MCP_ARGS=           # e.g. run python src/server.py
PROMPT_MCP_CWD=            # forge-mcp-server directory (blank → bot's cwd)
