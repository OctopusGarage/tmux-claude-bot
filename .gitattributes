# Exclude dev-only files from `git archive` / GitHub release tarballs.
# A release only needs to install + run: src/, the launchd/service scripts,
# package*.json, .env.example, tsconfig.json, install.sh, README.md, INSTALL.md.
/tests           export-ignore
/docs            export-ignore
/.github         export-ignore
/.husky          export-ignore
/biome.json      export-ignore
/vitest.config.ts        export-ignore
/tsconfig.tests.json     export-ignore
/.dependency-cruiser.cjs export-ignore
/knip.json       export-ignore
/renovate.json   export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
# Dev-only docs and scripts (a release must not carry these).
/CONTRIBUTING.md export-ignore
/CLAUDE.md       export-ignore
/CONTEXT.md      export-ignore
/dev.sh          export-ignore
/rebuild.sh      export-ignore
/scripts/release.sh export-ignore
/scripts/start.sh   export-ignore
/scripts/status.sh  export-ignore
/scripts/stop.sh    export-ignore
