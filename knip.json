{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/scripts/*.ts"],
  "project": ["src/**/*.ts"],
  "ignoreBinaries": [
    "scripts/install-service.sh",
    "scripts/uninstall-service.sh",
    "scripts/release.sh",
    "scripts/service.sh",
    "scripts/install-whisper.sh",
    "shellcheck",
    "ps"
  ],
  "ignoreExportsUsedInFile": true,
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["tests/**/*.test.ts"]
  }
}
